<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                App Links: convites chegam por WhatsApp como link https. Sem isto o
                link abre no Chrome mesmo com o app instalado, e o usuário acaba com
                duas instâncias (uma no app, outra no navegador).
                autoVerify exige /.well-known/assetlinks.json servido pelo host —
                está em public/.well-known/assetlinks.json, com o SHA-256 da chave
                de assinatura a preencher antes de publicar.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.s2core.com.br" android:pathPrefix="/convite-personal" />
                <data android:scheme="https" android:host="app.s2core.com.br" android:pathPrefix="/convite-nutri" />
                <data android:scheme="https" android:host="app.s2core.com.br" android:pathPrefix="/invite" />
                <data android:scheme="https" android:host="app.s2core.com.br" android:pathPrefix="/app" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
            Coleta de GPS que sobrevive ao WebView ser suspenso (P1B).
            `exported="false"`: ninguém de fora do app pode iniciá-lo.
            `stopWithTask="false"`: fechar o app da lista de recentes no meio de
            uma corrida não deve encerrar a corrida.
        -->
        <service
            android:name=".tracker.LocationForegroundService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="location" />

        <!--
            Lock Screen do treino de musculação (P1D). Serviço PRÓPRIO,
            separado do de localização acima — musculação não usa GPS, e
            exigir permissão de localização de quem só treina na academia
            seria pedir algo sem motivo (a Play Store audita se o tipo
            declarado bate com o uso real do app).
        -->
        <service
            android:name=".workout.WorkoutForegroundService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />

    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        O WebView do Capacitor não concede geolocalização nem câmera se o app não
        declarar a permissão — as APIs web (navigator.geolocation, getUserMedia)
        falham em silêncio no app empacotado, ainda que funcionem no navegador.

        Localização: Tracker de corrida, incluindo com a tela bloqueada (P1B),
        via serviço de primeiro plano do tipo `location`.
        Câmera: Lab de Movimento (análise roda no aparelho, nada é gravado).
        Notificações: obrigatória a partir do Android 13 — e o serviço de
        primeiro plano depende dela para existir.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Serviço de primeiro plano para o Tracker.

        FOREGROUND_SERVICE_LOCATION é exigida a partir do Android 14 (API 34)
        para um serviço declarar `foregroundServiceType="location"`; sem ela o
        app lança SecurityException ao iniciar a corrida nesses aparelhos.

        ACCESS_BACKGROUND_LOCATION continua NÃO sendo pedida, e isso é decisão,
        não esquecimento: um serviço de primeiro plano do tipo `location`
        iniciado com o app visível — que é sempre o caso aqui, o gatilho é o
        toque em "iniciar atividade" — mantém acesso à localização sem ela.
        Pedi-la obrigaria a uma declaração dedicada na Play Store, com vídeo de
        demonstração e revisão própria, em troca de nada que este fluxo use.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!--
        Serviço de primeiro plano do treino de musculação (P1D). `dataSync` é
        o tipo genérico — nenhum dos tipos "certos" descreve "mostrar
        progresso de treino" — e normal/auto-concedida como as demais
        FOREGROUND_SERVICE_*, sem prompt de runtime.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
        "Salvar imagem" do card de treino grava em Documents (@capacitor/filesystem).
        Do Android 10 em diante o armazenamento é por escopo e nada é pedido; em
        Android 9 e abaixo (minSdk 23) a gravação em diretório público exige esta
        permissão, e sem ela o plugin pede um consentimento que o sistema nega de
        imediato. `maxSdkVersion=28` deixa claro que ela só vale nesses aparelhos —
        em celular moderno não aparece na listagem da loja nem é solicitada.

        NÃO usamos a galeria (MediaStore): isso custaria outra permissão, e a SPEC
        §13 manda pedir só o indispensável. Quem quer a foto na galeria usa
        "Compartilhar" e salva pelo próprio sistema.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Recursos opcionais: não excluir aparelhos sem GPS/câmera da Play Store. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
