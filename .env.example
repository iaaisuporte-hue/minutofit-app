# Frontend Environment Variables for CoreFit
# Copy this file to .env and fill in the values

# API Configuration
VITE_API_URL=http://localhost:3000/api

# Recepção — tenta consumir GET /academy/recepcao/stream (requer RECEPCAO_SSE_ENABLED=true no backend)
# VITE_RECEPCAO_SSE=true

# Google OAuth Configuration
# Get Client ID from: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Apple OAuth Configuration  
# Get these from: https://developer.apple.com/account/resources/identifiers/list
VITE_APPLE_CLIENT_ID=your_apple_services_id_here
VITE_APPLE_TEAM_ID=your_apple_team_id_here
VITE_APPLE_KEY_ID=your_apple_key_id_here
