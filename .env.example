# Frontend Environment Variables for CoreFit
# Copy this file to .env and fill in the values

# API Configuration
VITE_API_URL=http://localhost:3000/api

# Recepção — tenta consumir GET /academy/recepcao/stream (requer RECEPCAO_SSE_ENABLED=true no backend)
# VITE_RECEPCAO_SSE=true

# Google OAuth Configuration
# Get Client ID from: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
# Client ID OAuth do tipo "iOS" criado no Google Cloud Console (bundle
# com.s2core.app). É OUTRO client, distinto do web acima e do Android — sem ele
# o login Google dentro do app iOS falha em runtime, com o código correto.
# O esquema reverso desse mesmo client precisa entrar em CFBundleURLTypes
# (ios/App/App/Info.plist).
VITE_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id_here

# Apple OAuth Configuration
# Get these from: https://developer.apple.com/account/resources/identifiers/list
# VITE_APPLE_CLIENT_ID é o Services ID e serve ao caminho WEB do Sign in with
# Apple. No app iOS o fluxo é nativo e se identifica pelo bundle ID — não usa
# esta env. TEAM_ID e KEY_ID são configuração de portal/backend (assinatura da
# chave), não consumidos pelo SDK JS da Apple.
VITE_APPLE_CLIENT_ID=your_apple_services_id_here
VITE_APPLE_TEAM_ID=your_apple_team_id_here
VITE_APPLE_KEY_ID=your_apple_key_id_here
# URL de retorno registrada no Services ID. Opcional: sem ela usamos a origem
# que serviu a página (ex.: https://app.s2core.com.br).
# VITE_APPLE_REDIRECT_URI=https://app.s2core.com.br
